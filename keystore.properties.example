# Copy to keystore.properties (git-ignored) to sign release builds.
#
# Create the release key once and keep it (and its passwords) safe: every future update
# must be signed with it, otherwise users cannot update in place.
#   keytool -genkeypair -v -keystore keys/nodpi-release.jks -alias nodpi -keyalg RSA -keysize 4096 -validity 36500
#
# storeFile is relative to the project root
storeFile=keys/nodpi-release.jks
storePassword=
keyAlias=nodpi
keyPassword=
